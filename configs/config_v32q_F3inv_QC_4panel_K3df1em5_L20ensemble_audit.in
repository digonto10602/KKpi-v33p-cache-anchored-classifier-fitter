# v32q: projected F3inv/projected QC 4-panel diagnostic using cached F3^{-1}_full and Vsel.
# Fix: default ensemble is now the L=20 mass-file prefix, matching Lval=20.
# Lattice mass files are treated as already Ecm by default; no moving-frame subtraction unless lattice_energy_type=En_lab.
# No fitting. C++ computes and saves: slogdet(projectedF3inv), slogdet(projectedQC), min(absEigQC), min(SVprojQC).

list_of_mom = 000_A1m 100_A2 110_A2 111_A2 200_A2
waves_vec_1 = 0 1
waves_vec_2 = 0

Lval = 20
xival = 3.444
scan_E0 = 0.261
scan_E1 = 0.36
coarseN = 10000
refineN = 0
iterative_refine_enable = 0
omp_threads = 18
debug = n

atmK = 0.09698
atmpi = 0.06906
eta_1 = 1.0
eta_2 = 0.5
alpha = 0.5
epsilon_h = 0.0
max_shell_num = 20.0
tolerance = 1.0e-12
parity = -1
eig_tol = 0.05
norm_tol = 1.0e-12
proj_tol = 1.0e-10

# Fixed lattice-mass two-body s+p scattering parameters.
scatter1_00 = 4.04
scatter1_10 = -43.2
scatter2_00 = 4.12

# Lattice levels to overlay on the plot. Same labels/irreps as list_of_mom.
# IMPORTANT v32q default: mass files are treated as already-center-of-mass energies.
# Set lattice_energy_type = En_lab only if the file values are lab-frame energies needing sqrt(E^2-P^2).
use_lattice_covariance = 1
ensemble = szscl21_20_128_b1p50_t_x4p300_um0p0840_sm0p0743_n1p265
energy_cutoff = 0.335
max_state = 8
masses_path =
print_found_files = 1
chi_square_mode = raw_cov_inv
lattice_energy_type = Ecm

# Fixed K3df values used to build QC = F3^{-1} + K3df. User-requested default: all 0.00001.
K3iso0 = 0.00001
K3iso1 = 0.00001
K3B = 0.00001
K3E = 0.00001

# Old classifier: sign flip in signed slogdet(det(projected QC)) and old peak support tests.
use_digonto_classifier_v1 = 1
classifier_mode = old_peak_on_projected_QC_slogdet
classifier_peak_ratio_min = 50
classifier_shoulder_gap = 2
zero_energy_mode = linear

# Cache-only behavior. Put your existing cache at cache/cache.bin or keep the v32j name.
write_cache_grid = 0
save_binary_f3inv_cache = 1
load_binary_f3inv_cache = 1
require_existing_binary_f3inv_cache = 1
binary_f3inv_cache_file = cache/cache.bin

# Noninteracting calculator config generated by run script from these same values.
nonint_nmax = 5
nonint_double_cover = y
nonint_output_dir = output_nonint_v32q

output_dir = output_v32q_4panel
output_tag = debug_v32q_F3inv_QC_4panel_K3df1em5_L20ensemble_audit

# v32q audit files will show every discovered mass file, its jackknife mean, and keep/reject status.
