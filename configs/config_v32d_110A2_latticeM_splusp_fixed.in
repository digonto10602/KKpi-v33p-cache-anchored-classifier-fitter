# v32d lattice-mass 110_A2 projected F3^{-1}+F3inv_iso diagnostic
# Requested setup:
#   irrep = 110_A2
#   waves_vec_1 = {0,1}, waves_vec_2 = {0}
#   M1 = atmK = 0.09698, M2 = atmpi = 0.06906
#   xi = 3.444, Lbyas = 20, L = Lbyas*xi
#   Ecm in [0.26,0.36]
#   coarseN = 1000, refineN = 20 by default in the run script
# Scattering convention: scatter_params_i_ell_paramind
#   scatter_params_1 -> spectator M1, interacting pair (M1,M2) = K-pi
#   scatter_params_2 -> spectator M2, interacting pair (M1,M1) = K-K
#   paramind=0 is scattering-length-like; paramind=1,2 are zero unless set.

list_of_mom = 110_A2
waves_vec_1 = 0 1
waves_vec_2 = 0

# Lattice anisotropic setup. In this code config key Lval is Lbyas.
Lval = 20
xival = 3.444
scan_E0 = 0.26
scan_E1 = 0.36
coarseN = 1000
omp_threads = 18
debug = n

# physics: two particles with mass M1=atmK and one with mass M2=atmpi
atmK = 0.09698
atmpi = 0.06906
eta_1 = 1.0
eta_2 = 0.5
alpha = 0.5
epsilon_h = 0.0
max_shell_num = 20.0
tolerance = 1.0e-12
parity = -1
eig_tol = 0.05
norm_tol = 1.0e-12
proj_tol = 1.0e-10
Q0norm = 1
sort_orbit_flag = 0

# non-interacting shell scan
nonint_nmax = 8
nonint_nsq_max = 24
energy_group_tol = 1.0e-10

# diagnostic thresholds retained for C++ audit compatibility
zero_minabs_eig_max = 1.0e-5
zero_min_sv_max = 1.0e-5
candidate_merge_tol = 2.0e-4
oracle_match_tol = 2.5e-4
refine_iter = 20
smoke_test = 0
smoke_only = 0
audit_eigenbranch_detail = 0
refine_zero_roots = 1

# v32 iterative refinement around det(projected F3inv) sign-flip brackets
signflip_refine_enable = 1
signflip_refine_points = 20
iterative_signflip_refine_enable = 1
iterative_refineN = 20
iterative_refine_max_rounds = 50
iterative_refine_tol = 1.0e-6

# digonto_classifier_v1 plot classifier defaults
# Rule: any det(proj F3inv) sign flip + Gaussian-like peak in smallest eigenvalue + Gaussian-like peak in minSV
make_plots = 1
plot_show = 0
plot_nscale = 300
digonto_classifier_v1_orientation = any
digonto_classifier_v1_peak_ratio = 50
digonto_classifier_v1_outer_points = 80
digonto_classifier_v1_core_points = 2

# Fixed scattering parameters for lattice masses: s-wave piK, p-wave piK, and s-wave KK.
# These match the previously used fixed lattice-mass values in the codebase.
scatter1_00 = 4.04
scatter1_10 = -43.2
scatter2_00 = 4.12

# output
output_dir = output_lattice
output_tag = debug_v32d_110A2_latticeM_L20xi3p444_waves01_fixed_sp
