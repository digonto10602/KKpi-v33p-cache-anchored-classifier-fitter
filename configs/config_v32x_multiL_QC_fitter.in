# v32x multi-Lbyas QC fitter configuration
#
# Purpose:
#   Fit Lbyas=20 and Lbyas=24 together using jackknife lattice spectra,
#   block-diagonal covariance across independent L ensembles, v32zu GPU
#   coarse F3inv/Vsel caches, and CPU-built refinement points.

# --- multi-L lattice data input ---
Lbyas_values = 20 24
lattice_jackknife_dir = /home/digonto/Codes/KKpi_I2/spectrum/Ecm_data/data
lattice_jack_energy_type = En_lab
jack_skip_header_lines = 1
jack_energy_column = 2
Ecm_cutoff = 0.335
energy_cutoff = 0.335

# Each L can have its own internal irrep list.  Filename aliases are accepted:
#   001_A2 -> 100_A2, 011_A2 -> 110_A2, 002_A2 -> 200_A2
irreps_L20 = 000_A1m 100_A2 110_A2 111_A2 200_A2
irreps_L24 = 000_A1m 100_A2 110_A2 111_A2 200_A2
list_of_mom = 000_A1m 100_A2 110_A2 111_A2 200_A2

# --- physics inputs, kept consistent with v32zu GPU cachegen and v32w fitter ---
xival = 3.444
atmK = 0.09698
atmpi = 0.06906
eta_1 = 1.0
eta_2 = 0.5
alpha = 0.5
epsilon_h = 0.0
max_shell_num = 20
tolerance = 1e-12
parity = -1
eig_tol = 0.05
norm_tol = 1e-12
proj_tol = 1e-10
waves_vec_1 = 0 1
waves_vec_2 = 0
scatter1_00 = 4.04
scatter1_10 = -43.2
scatter2_00 = 4.12

# p-wave safety: do not set scatter1_10 to zero when waves_vec_1 includes ell=1.

# --- coarse GPU cache grid ---
# These values are used for the fixed coarse scan only.  Refined points are CPU-built
# and saved separately.
scan_E0 = 0.26301
scan_E1 = 0.36
coarseN = 10000
gpu_cachegen_Ecm_min = 0.26301
gpu_cachegen_Ecm_max = 0.36
gpu_cachegen_coarseN = 10000
refineN = 0
omp_threads = 18
debug = n

# Use v32zu GPU cachegen if a required coarseN cache is missing.
auto_build_missing_coarse = 1
gpu_cachegen_root = external/v32zu_gpu_cachegen
coarse_cache_root = /media/digonto/Data/F3inv_cache
use_gpu_cache_meta_validation = 1

# Explicit coarse cache files.  These are immutable coarse scan inputs only.
coarse_cache_file_list
20 000_A1m /media/digonto/Data/F3inv_cache/v32zu_Lbyas20_gpu_cache/v32zu_Lbyas20_xi3p444_irrep000_A1m_coarse10000_F3inv_Vsel_gpu.bin
20 100_A2  /media/digonto/Data/F3inv_cache/v32zu_Lbyas20_gpu_cache/v32zu_Lbyas20_xi3p444_irrep100_A2_coarse10000_F3inv_Vsel_gpu.bin
20 110_A2  /media/digonto/Data/F3inv_cache/v32zu_Lbyas20_gpu_cache/v32zu_Lbyas20_xi3p444_irrep110_A2_coarse10000_F3inv_Vsel_gpu.bin
20 111_A2  /media/digonto/Data/F3inv_cache/v32zu_Lbyas20_gpu_cache/v32zu_Lbyas20_xi3p444_irrep111_A2_coarse10000_F3inv_Vsel_gpu.bin
20 200_A2  /media/digonto/Data/F3inv_cache/v32zu_Lbyas20_gpu_cache/v32zu_Lbyas20_xi3p444_irrep200_A2_coarse10000_F3inv_Vsel_gpu.bin
24 000_A1m /media/digonto/Data/F3inv_cache/v32zu_Lbyas24_gpu_cache/v32zu_Lbyas24_xi3p444_irrep000_A1m_coarse10000_F3inv_Vsel_gpu.bin
24 100_A2  /media/digonto/Data/F3inv_cache/v32zu_Lbyas24_gpu_cache/v32zu_Lbyas24_xi3p444_irrep100_A2_coarse10000_F3inv_Vsel_gpu.bin
24 110_A2  /media/digonto/Data/F3inv_cache/v32zu_Lbyas24_gpu_cache/v32zu_Lbyas24_xi3p444_irrep110_A2_coarse10000_F3inv_Vsel_gpu.bin
24 111_A2  /media/digonto/Data/F3inv_cache/v32zu_Lbyas24_gpu_cache/v32zu_Lbyas24_xi3p444_irrep111_A2_coarse10000_F3inv_Vsel_gpu.bin
24 200_A2  /media/digonto/Data/F3inv_cache/v32zu_Lbyas24_gpu_cache/v32zu_Lbyas24_xi3p444_irrep200_A2_coarse10000_F3inv_Vsel_gpu.bin
end_coarse_cache_file_list

# --- CPU refined cache behavior ---
# These refined points are generated by the CPU v32w/v32f code during local bracket
# refinement. They are never mixed into the initial coarse sign-flip scan.
refined_cache_dir = /media/digonto/Data/F3inv_cache/v32x_multiL_refined_cache
refined_cache_prefix = v32x_multiL
save_refined_cache = 1

# --- digonto_classifier_v2_one_shoulder ---
const_norm_power = 6
v2_refine_points = 10
v2_max_split_depth = 8
v2_zero_ratio = 0.80

# --- Minuit Kdf3 initial parameters: last best-known v32w values ---
K3iso0_guess = 34470.228772793678
K3iso1_guess = -1035173.9140440958
K3B_guess    = 253921.14757953485
K3E_guess    = -961680.91711685632

# Conservative default steps.  Adjust if Minuit fails to move or explores too aggressively.
K3iso0_step = 1000.0
K3iso1_step = 10000.0
K3B_step    = 1000.0
K3E_step    = 10000.0
use_parameter_limits = 0
param_lower = -1e8
param_upper = 1e8
max_fcn = 0

# --- covariance and chi-square ---
# Multi-L loader always builds full covariance within each L and zero cross-L blocks.
use_lattice_covariance = 1
chi_square_mode = raw_cov_inv
failure_penalty = 1e100
print_each_fcn_eval = 1
print_every_fcn_eval = 1

# --- outputs ---
output_dir = output_v32x_multiL_QC_fitter
output_tag = debug_v32x_multiL_QC_fitter
